// Konfigurasi Cloudflare Worker "desa-api".
// Lokal : npm run dev   -> http://localhost:8787, konek ke Postgres lokal (localConnectionString)
// Online: npm run deploy -> https://desa-api.<akun>.workers.dev, konek ke Supabase lewat Hyperdrive
{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "desa-api",
	"main": "src/index.js",
	"compatibility_date": "2026-10-01",
	// driver `postgres` butuh modul Node (net, crypto, dll.)
	"compatibility_flags": [
		"nodejs_compat"
	],
	"hyperdrive": [
		{
			// dipakai di kode sebagai env.HYPERDRIVE
			"binding": "HYPERDRIVE",
			// Hyperdrive "desa-db" -> Supabase project game-simulator
			"id": "9452597ccdc04ecea7a29f73efdcbe9a",
			// hanya dipakai saat `wrangler dev`. Hyperdrive wajib ada password; Postgres lokal (trust) mengabaikannya
			"localConnectionString": "postgres://putra:local@localhost:5432/desa_majapahit"
		}
	],
	// Batas burst chat: maks 8 pesan per 60 detik per IP (Workers Rate Limiting, gratis)
	"ratelimits": [
		{
			"name": "CHAT_LIMITER",
			"namespace_id": "1001",
			"simple": { "limit": 8, "period": 60 }
		}
	],
	"vars": {
		// asal (origin) yang boleh memanggil API ini dari browser
		"ALLOWED_ORIGINS": "https://radiputra.biz.id,http://localhost:5173",
		// kuota chat Claude per hari (reset tiap tengah malam UTC)
		"CHAT_DAILY_PER_IP": "60",
		"CHAT_DAILY_GLOBAL": "300"
	}
	// Secret (tidak ditulis di sini): ANTHROPIC_API_KEY
	//   online: npx wrangler secret put ANTHROPIC_API_KEY
	//   lokal : isi worker/.dev.vars (lihat .dev.vars.example)
}